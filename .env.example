# Local development only (`npm run dev`).
# On AWS these values come from sst.config.ts (database URL, NEXTAUTH_URL, FROM_EMAIL)
# and SST secrets (`npx sst secret set NextAuthSecret ... --stage <stage>`).

# Database (local Docker Postgres from docker-compose.yml, or an Aurora stage via `npx sst tunnel`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/picknroll"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/picknroll"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Email (Amazon SES). Leave unset locally to skip sending; uses your AWS credentials when set.
# FROM_EMAIL="Pick N Roll <noreply@staging.picknroll.net>"

# Google Gemini (Optional - for AI bracket reading)
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# Entry fee, deadline, and PayPal/Venmo details are set per pool in Admin → Pools.
# Teams come from Admin → Tournament (imported from ESPN).
